---
import { getImage } from 'astro:assets';
import '../styles/global.css';
import config from '../data/config.json';
import photoInfo from '../data/photos.json';
import tripData from '../data/trips.json';
import { buildSignature } from '../lib/signature';

const byName = (a: string, b: string) => a.localeCompare(b, 'en', { numeric: true });
const fileName = (p: string) => p.split('/').pop()!;

// "new-york_night.jpg" -> "New york night"; camera names (IMG_1234) get no title
const titleFromFile = (name: string) => {
  const base = name.replace(/\.[^.]+$/, '');
  if (/^(IMG|DSC|DSCF|PXL|P\d)[-_ ]?\d/i.test(base)) return '';
  return base.replace(/[-_]+/g, ' ').replace(/^\w/, (c) => c.toUpperCase());
};

const files = import.meta.glob<{ default: ImageMetadata }>('../assets/gallery/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP}', { eager: true });
const photos = await Promise.all(
  Object.keys(files).sort(byName).map(async (p, i) => {
    const src = files[p].default;
    const name = fileName(p);
    const info = (photoInfo as Record<string, { place?: string; title?: string; year?: string }>)[name] ?? {};
    const thumb = await getImage({ src, width: Math.min(420, src.width), format: 'webp', quality: 72 });
    const large = await getImage({ src, width: Math.min(2000, src.width), format: 'webp', quality: 82 });
    return {
      n: String(i + 1).padStart(3, '0'),
      title: info.title || titleFromFile(name),
      place: info.place || 'Other',
      meta: [info.place, info.year].filter(Boolean).join(' · '),
      thumb: thumb.src,
      large: large.src,
      ratio: src.width / src.height,
    };
  })
);
const total = String(photos.length).padStart(3, '0');
const trips = tripData.trips;
const tripOf = (place: string) => {
  const k = trips.findIndex((t) => t.places.includes(place));
  return k < 0 ? trips.length - 1 : k;
};

// before/after pairs: name-before.jpg + name-after.jpg
const pairFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/before-after/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP}', { eager: true });
const groups: Record<string, { before?: ImageMetadata; after?: ImageMetadata }> = {};
for (const p of Object.keys(pairFiles)) {
  const m = fileName(p).match(/^(.*?)[-_ ](before|after)\.[^.]+$/i);
  if (!m) continue;
  groups[m[1]] ??= {};
  groups[m[1]][m[2].toLowerCase() as 'before' | 'after'] = pairFiles[p].default;
}
const pairs = await Promise.all(
  Object.keys(groups).sort(byName)
    .filter((k) => groups[k].before && groups[k].after)
    .map(async (k, i) => {
      const { before, after } = groups[k] as { before: ImageMetadata; after: ImageMetadata };
      const w = Math.min(1800, after.width);
      return {
        n: String(i + 1).padStart(2, '0'),
        title: titleFromFile(k + '.jpg'),
        before: (await getImage({ src: before, width: w, format: 'webp', quality: 82 })).src,
        after: (await getImage({ src: after, width: w, format: 'webp', quality: 82 })).src,
        ratio: after.width / after.height,
      };
    })
);

const signature = buildSignature(config.signature || config.name);
---

<html lang="en" data-theme="dark" data-light="0">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{config.name} — Portfolio</title>
    <meta name="description" content={`${config.name} · ${config.role}. ${config.headline}`} />
    <meta property="og:title" content={`${config.name} — Portfolio`} />
    <meta property="og:description" content={config.bio} />
    {photos[0] && <meta property="og:image" content={photos[0].large} />}
    <meta name="theme-color" content="#0c0c0b" />
    <script is:inline>
      try { const n = Number(localStorage.getItem('light') || 0); if (n >= 0 && n <= 3) { const h = document.documentElement; h.dataset.light = String(n); h.dataset.theme = n >= 2 ? 'light' : 'dark'; } } catch (e) {}
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body data-view="ring">
    <div class="grain" aria-hidden="true"></div>

    <div id="intro" aria-hidden="true">
      <svg class:list={["signature", "signature-large", { "signature-strokes": signature.handDrawn }]} viewBox={signature.viewBox}>
        {signature.strokes.map((s) => <path d={s.d} transform={s.transform} pathLength="1" />)}
      </svg>
    </div>

    <header class="corner top-left">
      <a href="/" class="brand" aria-label={config.name}>
        <svg class:list={["signature", "signature-small", { "signature-strokes": signature.handDrawn }]} viewBox={signature.viewBox} aria-hidden="true">
          {signature.strokes.map((s) => <path d={s.d} transform={s.transform} pathLength="1" />)}
        </svg>
      </a>
      <span class="muted">{config.role}</span>
    </header>

    <nav class="corner top-right">
      <button class="nav-btn active" data-go="ring">Ring</button>
      <button class="nav-btn" data-go="index">Index</button>
      {pairs.length > 0 && <button class="nav-btn" data-go="before-after">Before/After</button>}
      <button class="nav-btn" data-go="info">Info</button>
    </nav>

    <button id="lamp" aria-label="Light: off. Click for more light">
      <span class="lamp-cord"></span>
      <svg viewBox="0 0 12 12" aria-hidden="true">
        <defs>
          <radialGradient id="lampGlow" cx="50%" cy="50%" r="50%">
            <stop offset="0" stop-color="#fff4d6" stop-opacity="0.95" />
            <stop offset="0.4" stop-color="#ffc977" stop-opacity="0.42" />
            <stop offset="1" stop-color="#ffb04a" stop-opacity="0" />
          </radialGradient>
        </defs>
        <circle class="lamp-halo" cx="6" cy="6" r="20" fill="url(#lampGlow)" />
        <g class="lamp-body">
          <circle class="lamp-bulb" cx="6" cy="6" r="4" />
        </g>
      </svg>
      <span class="lamp-hint">On</span>
    </button>

    <div class="corner bottom-left"><span id="counter">000</span><span class="muted">/{total}</span></div>
    <div class="corner bottom-center">
      <div id="hover-title" aria-live="polite"></div>
      <div class="sort" role="tablist" aria-label="Sort the ring" data-mode="color">
        <button class="sort-btn active" role="tab" aria-selected="true" data-sort="color">Color</button>
        <span class="sort-track" aria-hidden="true"><span class="sort-knob"></span></span>
        <button class="sort-btn" role="tab" aria-selected="false" data-sort="trip">Trips</button>
      </div>
    </div>

    <main id="scene" aria-label="Gallery" data-trips={JSON.stringify(trips.map(({ name, subtitle, text }) => ({ name, subtitle, text })))}>
      <div id="labels" aria-hidden="true"></div>
      {photos.map((p, i) => (
        <button class="item" data-i={i} data-n={p.n} data-title={p.title} data-large={p.large} data-meta={p.meta} data-place={p.place} data-trip={tripOf(p.place)}
          style={`--ratio:${p.ratio}`} aria-label={`Open photograph ${p.n}`}>
          <img src={p.thumb} alt={p.title || `Photograph ${p.n}`} loading="eager" decoding="async" draggable="false" />
        </button>
      ))}
    </main>

    <aside id="trip-text" aria-live="polite" data-intro={tripData.intro}>
      <p class="tt-name"></p>
      <p class="tt-body">{tripData.intro}</p>
    </aside>

    <section id="index" class="panel" aria-label="Index of work">
      <div class="sort sort-index" role="tablist" aria-label="Sort the index" data-mode="color">
        <button class="sort-btn active" role="tab" aria-selected="true" data-sort="color">Color</button>
        <span class="sort-track" aria-hidden="true"><span class="sort-knob"></span></span>
        <button class="sort-btn" role="tab" aria-selected="false" data-sort="trip">Trips</button>
      </div>
      <ol class="grid">
        {photos.map((p, i) => (
          <li class={p.ratio > 1 ? 'wide' : ''}>
            <button class="cell" data-i={i}>
              <span class={`cell-img${p.ratio > 1 ? ' landscape' : ''}`} style={`--ratio:${p.ratio}`}>
                <img src={p.thumb} alt={p.title || `Photograph ${p.n}`} loading="lazy" decoding="async" />
              </span>
              <span class="cell-caption"><span class="muted">{p.n}</span> {p.title}</span>
            </button>
          </li>
        ))}
      </ol>
    </section>

    {pairs.length > 0 && (
      <section id="before-after" class="panel" aria-label="Before and after editing">
        <p class="before-after-intro muted">Hover or drag the bar to reveal the edit.</p>
        {pairs.map((p) => (
          <figure class="compare" style={`--ratio:${p.ratio}; --pos:50%`}>
            <div class="compare-frame">
              <img class="compare-before" src={p.before} alt={`${p.title} — before`} loading="lazy" decoding="async" draggable="false" />
              <img class="compare-after" src={p.after} alt={`${p.title} — after`} loading="lazy" decoding="async" draggable="false" />
              <span class="compare-tag left">Before</span>
              <span class="compare-tag right">After</span>
              <span class="compare-line" aria-hidden="true"><span class="compare-handle">↔</span></span>
              <input class="compare-range" type="range" min="0" max="100" value="50" step="0.1" aria-label={`Compare ${p.title || p.n}: before and after`} />
            </div>
            <figcaption><span class="muted">{p.n}</span> {p.title}</figcaption>
          </figure>
        ))}
      </section>
    )}

    <section id="info" class="panel" aria-label="About">
      <div class="info-box">
        <svg class:list={["signature", "signature-info", { "signature-strokes": signature.handDrawn }]} viewBox={signature.viewBox} aria-hidden="true">
          {signature.strokes.map((s) => <path d={s.d} transform={s.transform} pathLength="1" />)}
        </svg>
        <p class="info-headline">{config.headline}</p>
        <p class="info-bio">{config.bio}</p>
        <ul class="info-links">
          {config.email && <li><span class="muted">Say hello —</span> <a href={`mailto:${config.email}`}>{config.email}</a></li>}
          {config.instagram && <li><a href={config.instagram} target="_blank" rel="noopener">Instagram ↗</a></li>}
          {config.linkedin && <li><a href={config.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a></li>}
        </ul>
      </div>
    </section>

    <div id="viewer" aria-hidden="true">
      <img id="viewer-img" alt="" />
      <div class="viewer-caption">
        <span id="viewer-n"></span>
        <span id="viewer-title"></span>
        <span id="viewer-meta" class="muted"></span>
      </div>
      <button class="viewer-btn prev" aria-label="Previous">←</button>
      <button class="viewer-btn next" aria-label="Next">→</button>
      <button class="viewer-btn close" aria-label="Close">Close ✕</button>
    </div>

    <script>
      import { initPortfolio } from '../scripts/portfolio.ts';
      import { initLight } from '../scripts/light.ts';
      import { initCompare } from '../scripts/compare.ts';
      import { playIntro } from '../scripts/signature.ts';
      import { initSound } from '../scripts/sound.ts';
      import { analyseColors } from '../scripts/colors.ts';
      initLight();
      initSound();
      initCompare();
      const colors = analyseColors(Array.from(document.querySelectorAll<HTMLImageElement>('#scene .item img')));
      playIntro().then(() => colors).then(initPortfolio);
    </script>
  </body>
</html>
